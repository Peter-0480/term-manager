{
  "name": "term-manager",
  "version": "0.1.0",
  "description": "智能术语管理器 —— 轻量、本地优先、AI 赋能的桌面端术语管理工具",
  "author": "河外青鸟",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Peter-0480/term-manager.git"
  },
  "main": "./out/main/index.cjs",
  "type": "module",
  "scripts": {
    "dev": "node node_modules/electron-vite/bin/electron-vite.js dev",
    "build": "node node_modules/electron-vite/bin/electron-vite.js build",
    "preview": "node node_modules/electron-vite/bin/electron-vite.js preview",
    "package": "npm run build && node node_modules/electron-builder/cli.js",
    "rebuild": "node node_modules/@electron/rebuild/lib/cli.js -f -w better-sqlite3",
    "test": "node node_modules/vitest/vitest.mjs"
  },
  "dependencies": {
    "antd": "^5.10.0",
    "axios": "^1.6.0",
    "better-sqlite3": "^12.8.0",
    "cheerio": "^1.0.0-rc.14",
    "dayjs": "^1.11.20",
    "electron-store": "^8.1.0",
    "mammoth": "^1.4.23",
    "pdfjs-dist": "^4.10.38",
    "rc-picker": "^4.11.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.5.0",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "electron": "27.2.0",
    "electron-builder": "^24.6.0",
    "electron-vite": "^2.3.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0"
  },
  "build": {
    "appId": "com.bluebird.term-manager",
    "files": [
      "out/**/*",
      "!out/main/database.db"
    ],
    "win": {
      "icon": "build/青鸟.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/青鸟.ico",
      "uninstallerIcon": "build/青鸟.ico"
    }
  },
  "optionalDependencies": {
    "canvas": "^3.2.3"
  }
}
